{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calc result document v1",
  "description": "The document: its format, its version, and the result.",
  "type": "object",
  "properties": {
    "format": {
      "description": "Always `loom-calc-result`.",
      "type": "string",
      "const": "loom-calc-result"
    },
    "result": {
      "description": "The result.",
      "$ref": "#/$defs/CalcResult"
    },
    "version": {
      "description": "Always 1 in this version.",
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "result"
  ],
  "$defs": {
    "Adapted": {
      "description": "An import tolerance a line needed.",
      "oneOf": [
        {
          "description": "Letter case only.",
          "type": "string",
          "const": "case-folded"
        },
        {
          "description": "Resolved with the next line of another section.",
          "type": "string",
          "const": "split-section"
        }
      ]
    },
    "CalcResult": {
      "description": "A calculation's result.",
      "type": "object",
      "properties": {
        "fields": {
          "description": "Every field of the game's slice; empty when the game has no\ncalculation.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldResult"
          }
        },
        "game": {
          "description": "The build's game.",
          "$ref": "#/$defs/Game"
        },
        "graph": {
          "description": "The provenance graph; a node's position is its index.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "reasons": {
          "description": "The reasons that apply to every computed field.",
          "$ref": "#/$defs/Reasons"
        },
        "state": {
          "description": "The worst state of the fields; `unsupported` when the game has\nno calculation.",
          "$ref": "#/$defs/StateKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "game",
        "state",
        "reasons",
        "fields",
        "graph"
      ]
    },
    "FieldResult": {
      "description": "One field's result.",
      "type": "object",
      "properties": {
        "field": {
          "description": "The field's name (`life`, `resistance.fire`).",
          "type": "string"
        },
        "indeterminate": {
          "description": "Why the value cannot be settled: not empty exactly when `state`\nis `indeterminate`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndeterminateReason"
          }
        },
        "node": {
          "description": "The value's node in `graph`; absent when not computed. Its\nvalue is `value`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "reason": {
          "description": "Why the field is not computed: present exactly when `state` is\n`unsupported`.",
          "anyOf": [
            {
              "$ref": "#/$defs/UnsupportedReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "description": "The state.",
          "$ref": "#/$defs/StateKind"
        },
        "unsupported": {
          "description": "What was not modelled: not empty when `state` is `partial`,\npossibly empty when `indeterminate`, empty otherwise.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnsupportedReason"
          }
        },
        "value": {
          "description": "The value; absent when the field is not computed.",
          "anyOf": [
            {
              "$ref": "#/$defs/Number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "field",
        "state"
      ]
    },
    "Game": {
      "description": "A game.",
      "oneOf": [
        {
          "description": "Path of Exile.",
          "type": "string",
          "const": "poe1"
        },
        {
          "description": "Path of Exile 2.",
          "type": "string",
          "const": "poe2"
        }
      ]
    },
    "IndeterminateReason": {
      "description": "Why a value cannot be settled.",
      "oneOf": [
        {
          "description": "Two overrides of one quantity give different values.",
          "type": "object",
          "properties": {
            "conflicting-override": {
              "type": "object",
              "properties": {
                "quantity": {
                  "description": "The quantity.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "quantity"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "conflicting-override"
          ]
        },
        {
          "description": "A stat's value read from its line is not one number.",
          "type": "object",
          "properties": {
            "unsettled-value": {
              "type": "object",
              "properties": {
                "source": {
                  "description": "Where it comes from.",
                  "$ref": "#/$defs/Source"
                },
                "stat": {
                  "description": "The stat ID.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "stat",
                "source"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unsettled-value"
          ]
        },
        {
          "description": "The build names something the game data does not have.",
          "type": "object",
          "properties": {
            "missing-data": {
              "type": "object",
              "properties": {
                "key": {
                  "description": "The key the build gives.",
                  "type": "string"
                },
                "table": {
                  "description": "The table.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "table",
                "key"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "missing-data"
          ]
        },
        {
          "description": "The build's passive tree is another version than the data's.",
          "type": "object",
          "properties": {
            "tree-version": {
              "type": "object",
              "properties": {
                "build": {
                  "description": "The build's.",
                  "type": "string"
                },
                "data": {
                  "description": "The data's.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "build",
                "data"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "tree-version"
          ]
        }
      ]
    },
    "Node": {
      "description": "A provenance graph node. Its children are earlier nodes; its value\nis what the engine computed, equal to the graph's evaluation from\nthe leaves.",
      "type": "object",
      "properties": {
        "children": {
          "description": "The children's indices, in order: a sum's terms, a product's\nfactors, an override's `by` then `replaced`, a minimum's or\nmaximum's two inputs.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "kind": {
          "description": "What the node is.",
          "$ref": "#/$defs/NodeKind"
        },
        "term": {
          "description": "The breakdown term (`base`, `increased`, `more`, `override`,\n`result`, or `step.<name>`); absent for leaves and overrides.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "The value.",
          "$ref": "#/$defs/Number"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    "NodeKind": {
      "description": "What a node is, and how its children combine.",
      "oneOf": [
        {
          "description": "One effect from one source (a leaf; its value is the effect's).",
          "type": "object",
          "properties": {
            "contribution": {
              "type": "object",
              "properties": {
                "op": {
                  "description": "How it combines (`base`, `increased`, `more`, `flag`,\n`override`).",
                  "type": "string"
                },
                "quantity": {
                  "description": "What it changes.",
                  "type": "string"
                },
                "source": {
                  "description": "Where it comes from.",
                  "$ref": "#/$defs/Source"
                }
              },
              "additionalProperties": false,
              "required": [
                "source",
                "quantity",
                "op"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "contribution"
          ]
        },
        {
          "description": "A constant of a rule or of the game data (a leaf).",
          "type": "object",
          "properties": {
            "constant": {
              "type": "object",
              "properties": {
                "label": {
                  "description": "What it is.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "label"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "constant"
          ]
        },
        {
          "description": "The sum of the children, from 0.",
          "type": "string",
          "const": "sum"
        },
        {
          "description": "The product of the children, from 1.",
          "type": "string",
          "const": "product"
        },
        {
          "description": "`1 + child / 100`.",
          "type": "string",
          "const": "percent-factor"
        },
        {
          "description": "1 if a child is not 0, else 0.",
          "type": "string",
          "const": "any"
        },
        {
          "description": "The first child's value, replacing the second's.",
          "type": "string",
          "const": "override"
        },
        {
          "description": "The child rounded down.",
          "type": "string",
          "const": "floor"
        },
        {
          "description": "The child rounded half up.",
          "type": "string",
          "const": "round-half-up"
        },
        {
          "description": "The child's integer part, towards zero.",
          "type": "string",
          "const": "trunc"
        },
        {
          "description": "The smaller child.",
          "type": "string",
          "const": "min"
        },
        {
          "description": "The larger child.",
          "type": "string",
          "const": "max"
        },
        {
          "description": "The first child less the second.",
          "type": "string",
          "const": "difference"
        },
        {
          "description": "The first child divided by the second.",
          "type": "string",
          "const": "quotient"
        }
      ]
    },
    "NonFinite": {
      "description": "A non-finite number, by its IEEE 754 bit pattern.",
      "type": "object",
      "properties": {
        "f64_bits": {
          "description": "The bits as 16 lowercase hexadecimal digits.",
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "f64_bits"
      ]
    },
    "Number": {
      "description": "A number: a JSON number when finite, otherwise its bit pattern (JSON\nhas no NaN or infinity). Finite values are written in the shortest\nform that reads back to the same bits.",
      "anyOf": [
        {
          "description": "A finite number.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "A non-finite number.",
          "$ref": "#/$defs/NonFinite"
        }
      ]
    },
    "Reasons": {
      "description": "Reasons collected for the whole build.",
      "type": "object",
      "properties": {
        "indeterminate": {
          "description": "Values that could not be settled.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndeterminateReason"
          }
        },
        "unsupported": {
          "description": "Content that was not modelled.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnsupportedReason"
          }
        }
      },
      "additionalProperties": false
    },
    "Source": {
      "description": "Where a contribution comes from.",
      "oneOf": [
        {
          "description": "The character itself.",
          "type": "string",
          "const": "character"
        },
        {
          "description": "A line of an item.",
          "type": "object",
          "properties": {
            "item": {
              "type": "object",
              "properties": {
                "adapted": {
                  "description": "The import tolerance the line needed, if any.",
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Adapted"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "item": {
                  "description": "The item's ID.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "line": {
                  "description": "The line's index among the item's lines.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "item",
                "line"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "item"
          ]
        },
        {
          "description": "An item's base (the properties the game data gives it).",
          "type": "object",
          "properties": {
            "item-base": {
              "type": "object",
              "properties": {
                "item": {
                  "description": "The item's ID.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "item"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "item-base"
          ]
        },
        {
          "description": "An allocated passive node.",
          "type": "object",
          "properties": {
            "passive": {
              "type": "object",
              "properties": {
                "node": {
                  "description": "The node's ID.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "node"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "passive"
          ]
        },
        {
          "description": "A gem.",
          "type": "object",
          "properties": {
            "gem": {
              "type": "object",
              "properties": {
                "gem": {
                  "description": "The gem's index in the group.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "group": {
                  "description": "The socket group's index.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "group",
                "gem"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "gem"
          ]
        },
        {
          "description": "A config input.",
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "input": {
                  "description": "The input's name.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "input"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "config"
          ]
        },
        {
          "description": "The enemy.",
          "type": "string",
          "const": "enemy"
        },
        {
          "description": "A rule of the engine, by name.",
          "type": "object",
          "properties": {
            "rule": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "rule"
          ]
        }
      ]
    },
    "StateKind": {
      "description": "A state's kind, from best to worst.",
      "oneOf": [
        {
          "description": "Every contribution modelled.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "Computed; some content not modelled.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "Not computed.",
          "type": "string",
          "const": "unsupported"
        },
        {
          "description": "Not settled.",
          "type": "string",
          "const": "indeterminate"
        }
      ]
    },
    "UnsupportedReason": {
      "description": "Why a field is not complete, or not computed.",
      "oneOf": [
        {
          "description": "A stat the stat-to-effect mapping does not know.",
          "type": "object",
          "properties": {
            "unmapped-stat": {
              "type": "object",
              "properties": {
                "source": {
                  "description": "Where it comes from.",
                  "$ref": "#/$defs/Source"
                },
                "stat": {
                  "description": "The stat ID.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "stat",
                "source"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unmapped-stat"
          ]
        },
        {
          "description": "An item line that did not resolve.",
          "type": "object",
          "properties": {
            "unresolved-line": {
              "type": "object",
              "properties": {
                "reason": {
                  "description": "The resolver's reason.",
                  "type": "string"
                },
                "source": {
                  "description": "The line.",
                  "$ref": "#/$defs/Source"
                }
              },
              "additionalProperties": false,
              "required": [
                "source",
                "reason"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unresolved-line"
          ]
        },
        {
          "description": "An item line excluded by design whose effect the game may\nstill apply.",
          "type": "object",
          "properties": {
            "excluded-line": {
              "type": "object",
              "properties": {
                "exclusion": {
                  "description": "The exclusion.",
                  "type": "string"
                },
                "source": {
                  "description": "The line.",
                  "$ref": "#/$defs/Source"
                }
              },
              "additionalProperties": false,
              "required": [
                "source",
                "exclusion"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "excluded-line"
          ]
        },
        {
          "description": "An item line that was never resolved.",
          "type": "object",
          "properties": {
            "pending-line": {
              "type": "object",
              "properties": {
                "source": {
                  "description": "The line.",
                  "$ref": "#/$defs/Source"
                }
              },
              "additionalProperties": false,
              "required": [
                "source"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "pending-line"
          ]
        },
        {
          "description": "A typed resolution without a handler.",
          "type": "object",
          "properties": {
            "unhandled-kind": {
              "type": "object",
              "properties": {
                "kind": {
                  "description": "The typed resolution's `kind`.",
                  "type": "string"
                },
                "source": {
                  "description": "Where it comes from.",
                  "$ref": "#/$defs/Source"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "source"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unhandled-kind"
          ]
        },
        {
          "description": "An effect needs a named condition the build and config do not\nsettle.",
          "type": "object",
          "properties": {
            "unmodelled-condition": {
              "type": "object",
              "properties": {
                "condition": {
                  "description": "The condition's name.",
                  "type": "string"
                },
                "quantity": {
                  "description": "The quantity of the effect left out.",
                  "type": "string"
                },
                "source": {
                  "description": "The source of the effect left out.",
                  "$ref": "#/$defs/Source"
                }
              },
              "additionalProperties": false,
              "required": [
                "condition",
                "quantity",
                "source"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unmodelled-condition"
          ]
        },
        {
          "description": "A field derived from another field that is not computed.",
          "type": "object",
          "properties": {
            "depends-on-not-computed": {
              "type": "object",
              "properties": {
                "field": {
                  "description": "The field it needs.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "field"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "depends-on-not-computed"
          ]
        },
        {
          "description": "The engine does not compute this field yet.",
          "type": "string",
          "const": "not-computed"
        },
        {
          "description": "An enabled gem whose effects the engine does not model yet.",
          "type": "object",
          "properties": {
            "unmodelled-gem": {
              "type": "object",
              "properties": {
                "source": {
                  "description": "The gem.",
                  "$ref": "#/$defs/Source"
                }
              },
              "additionalProperties": false,
              "required": [
                "source"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unmodelled-gem"
          ]
        },
        {
          "description": "A config input the engine does not model yet.",
          "type": "object",
          "properties": {
            "unmodelled-config": {
              "type": "object",
              "properties": {
                "input": {
                  "description": "The input's name.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "input"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unmodelled-config"
          ]
        },
        {
          "description": "A game-specific build choice the engine does not model.",
          "type": "object",
          "properties": {
            "unmodelled-choice": {
              "type": "object",
              "properties": {
                "choice": {
                  "description": "Which choice.",
                  "type": "string"
                },
                "value": {
                  "description": "Its value, as the build writes it.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "choice",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unmodelled-choice"
          ]
        },
        {
          "description": "An item in use whose effect goes beyond its lines, not\nmodelled yet.",
          "type": "object",
          "properties": {
            "unmodelled-item": {
              "type": "object",
              "properties": {
                "item": {
                  "description": "The item's ID.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "slot": {
                  "description": "Its slot, as the build names it.",
                  "type": "string"
                },
                "what": {
                  "description": "What is not modelled.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "item",
                "slot",
                "what"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unmodelled-item"
          ]
        },
        {
          "description": "An allocated passive whose stats the data does not hold, by a\nrule of the game (a node generated from a jewel), not modelled\nyet.",
          "type": "object",
          "properties": {
            "unmodelled-passive": {
              "type": "object",
              "properties": {
                "source": {
                  "description": "The passive.",
                  "$ref": "#/$defs/Source"
                },
                "what": {
                  "description": "What is not modelled.",
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "source",
                "what"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unmodelled-passive"
          ]
        },
        {
          "description": "An item line the import did not read.",
          "type": "object",
          "properties": {
            "unread-line": {
              "type": "object",
              "properties": {
                "source": {
                  "description": "The line.",
