          },
          "additionalProperties": false,
          "required": [
            "done"
          ]
        },
        {
          "description": "Done, with text to give the user (a share code).",
          "type": "object",
          "properties": {
            "text": {
              "type": "object",
              "properties": {
                "text": {
                  "description": "The text.",
                  "type": "string"
                },
                "version": {
                  "description": "The version.",
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
