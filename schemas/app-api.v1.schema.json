        "standing-grant": {
          "description": "Requests apply without asking (a standing grant the user can\nrevoke).",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "requests",
        "standing-grant"
      ]
    },
    "McpStatus": {
      "description": "The MCP server (ADR-017).",
      "type": "object",
      "properties": {
        "permissions": {
          "description": "What clients may do.",
          "$ref": "#/$defs/McpPermissions"
        },
        "requests": {
          "description": "Change requests, newest last.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeRequest"
          }
        },
