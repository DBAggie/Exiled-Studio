    "RequestStatus": {
      "description": "A change request's status.",
      "oneOf": [
        {
          "description": "Waiting for the user.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Applied (approved, or under the standing grant).",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Declined by the user.",
          "type": "string",
          "const": "declined"
        },
        {
          "description": "It could not apply (the item changed, a line is gone, ...).",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "Snapshot": {
      "description": "The application's state at one version. Queries return it whole;\nevents say when it changed (ADR-004: a missed event version means\nquery again).",
      "type": "object",
      "properties": {
        "build": {
          "description": "The open build, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/BuildView"
            },
            {
              "type": "null"
            }
          ]
        },
        "calc": {
          "description": "The calculation of the latest version.",
          "$ref": "#/$defs/CalcStatus"
        },
        "data": {
          "description": "The game data the application calculates with.",
          "$ref": "#/$defs/DataStatus"
        },
        "dirty": {
          "description": "Whether the build changed since it was last saved or opened.",
          "type": "boolean"
        },
        "history": {
          "description": "Undo and redo.",
          "$ref": "#/$defs/HistoryView"
        },
        "notices": {
          "description": "Notices about the open build that are not errors (for example\n`APP_RESOLUTION_CHANGED`: the build's stored resolutions differ\nfrom this bundle's, so they stand and rolled values stay\nunsettled).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiError"
          }
        },
        "origin": {
          "description": "The file the build was imported from, if any; never written.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Where the build is saved (a build document), if it is.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Increases with every change of the build (import, open, edit,\nundo, redo); 0 before any build.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "calc",
        "history",
        "dirty",
        "data",
        "notices"
      ]
    },
