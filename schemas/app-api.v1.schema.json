              "required": [
                "version",
                "text"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        },
        {
          "description": "Nothing to do (undo with an empty history, a cancelled dialog).",
          "type": "string",
          "const": "nothing"
        }
      ]
