            "null"
          ]
        },
        "line": {
          "description": "The line's index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "text": {
          "description": "The line as written.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "item",
        "line",
        "text",
        "code"
      ]
    }
