    "LineStatus": {
      "description": "A line's status, as the UI names it (`docs/ui/UI-DESIGN-BRIEF.md`,\nterminology).",
      "oneOf": [
        {
          "description": "Resolved to game stats or a typed kind.",
          "type": "string",
          "const": "matched"
        },
        {
          "description": "Resolved after an import tolerance.",
          "type": "string",
          "const": "adapted"
        },
        {
          "description": "Kept and shown, not calculated (ADR-015).",
          "type": "string",
          "const": "warning"
        },
        {
          "description": "Excluded by the item.",
          "type": "string",
          "const": "excluded"
        },
        {
          "description": "Continues the line before it (one description over several\nlines).",
          "type": "string",
          "const": "continues"
        },
        {
          "description": "Not a modifier line.",
          "type": "string",
          "const": "other"
        }
      ]
    },
    "LineView": {
      "description": "One source line of an item.",
      "type": "object",
      "properties": {
        "adapted": {
          "description": "The tolerance it needed (`case-folded`, `split-section`).",
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "description": "The warning's code (`LINE_NO_TEMPLATE`, ...), when the status is\n`warning`.",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "description": "The line's index among the item's lines.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "description": "What it is: the domain's line kind name (`modifier`, `spec`,\n`name`, ...).",
          "type": "string"
        },
        "numbers": {
          "description": "The numbers in the text, in order, for roll edits.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NumberSpan"
          }
        },
        "section": {
          "description": "The modifier list it belongs to (`implicit`, `explicit`, ...);\nmodifier lines only.",
          "type": [
            "string",
            "null"
          ]
        },
        "stats": {
          "description": "What the line resolved to: game stats, or a typed kind.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StatView"
          }
        },
        "status": {
          "description": "Its status.",
          "$ref": "#/$defs/LineStatus"
        },
        "text": {
          "description": "The line as written.",
          "type": "string"
        },
        "typed": {
          "description": "The typed kind (`granted-skill`, ...), if it resolved to one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "index",
        "text",
        "kind",
        "status",
        "stats",
        "numbers"
      ]
