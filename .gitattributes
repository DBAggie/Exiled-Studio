# Normalize to LF everywhere so fmt checks agree on Windows and Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.ico binary
*.icns binary
*.woff2 binary
*.zip binary

# Vendored third-party data: keep the committed bytes exact (the hash is checked in tests).
tools/extractor/schema/schema.min.json binary

# Synthetic data bundles: bundle.json records each file's SHA-256 (P2-3).
crates/loom-data/tests/fixtures/bundle-*/** -text

# PoB-made share codes and the XML each was made from (P2-10): the code must decode to the exact bytes.
tools/oracle/fixtures/share-codes/** -text
