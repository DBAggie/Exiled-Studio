# Normalize to LF everywhere so fmt checks agree on Windows and Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.ico binary
*.icns binary
*.woff2 binary

# Vendored third-party data: keep the committed bytes exact (the hash is checked in tests).
tools/extractor/schema/schema.min.json binary
