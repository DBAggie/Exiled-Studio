{
  "name": "@loom/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:schema": "json2ts --input ../schemas/build.v1.schema.json --output src/generated/build.v1.ts --bannerComment \"// Generated from schemas/build.v1.schema.json by `pnpm generate:schema`; do not edit.\" && prettier --write src/generated",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  }
}
